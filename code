import whisper
import ollama

# Configurações
audio_data = "namesake.mp3"

print("[*] Transcrevendo áudio...")
# Carrega o modelo do Whisper
whisper_model = whisper.load_model("base")

# Executa a transcrição
result = whisper_model.transcribe(audio_data, fp16=False)
transcribed = result['text']

print("[*] Extraindo e traduzindo contexto...")
# Monta o prompt para o Ollama
prompt = f"""
Based on the transcribed text below, translate its context to portuguese:
Transcription: {transcribed}
"""

# Gera a resposta com o Llama 3.2
response = ollama.generate(model="llama3.2:1b", prompt=prompt)

print("\n=== RESULTADO ===")
print(response['response'])
